# Fjorr — Next.js website. Copy to .env.local and fill in.
# Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some helpers:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (Control at /admin) ---
ADMIN_EMAILS=

# --- Postmark (nomination status emails) ---
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=Fjorr <intel@fjorr.com>

# --- Site gate (pre-launch; keep enabled on staging + production) ---
SITE_PASSWORD=
SITE_GATE_ENABLED=true

# --- Stripe (The Bureaux annual subscription — Embedded Checkout) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUREAUX_PRICE_ID=
# Display only (cents). Default 4800 = $48/year.
NEXT_PUBLIC_BUREAUX_ANNUAL_CENTS=4800
# Optional override for Checkout return URLs (local/staging).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI ---
OPENAI_API_KEY=

# --- Mux / R2 ---
NEXT_PUBLIC_MUX_TOKEN_ID=
NEXT_PUBLIC_MUX_TOKEN_SECRET=
NEXT_PUBLIC_R2_ACCESS_KEY_ID=
NEXT_PUBLIC_R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_ACCOUNT_ID=
NEXT_PUBLIC_R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=
